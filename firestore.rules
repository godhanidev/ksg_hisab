rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper Validation Functions ──────────────────────────────────────────
    function isValidNumber(val) {
      return val is number && val >= 0;
    }
    
    function isNonEmptyString(val) {
      return val is string && val.size() > 0 && val.size() <= 500;
    }

    // ── 1. Projects Collection ───────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is number
                            && isNonEmptyString(request.resource.data.name);
      allow delete: if true;
    }

    // ── 2. Daily Cash Transactions (જમા & ઉધાર) ──────────────────────────────
    match /daily_cash/{txId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is number
                            && isValidNumber(request.resource.data.amount)
                            && isNonEmptyString(request.resource.data.project)
                            && (request.resource.data.type == "cash_in" || request.resource.data.type == "cash_out");
      allow delete: if true;
    }

    // ── 3. Bank Payments (બેંક ટ્રાન્સફર) ────────────────────────────────────
    match /bank_payments/{paymentId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is number
                            && isValidNumber(request.resource.data.amount)
                            && isNonEmptyString(request.resource.data.partyName)
                            && isNonEmptyString(request.resource.data.project);
      allow delete: if true;
    }

    // ── 4. GST Bills (ટેક્સ ઇન્વોઇસ) ─────────────────────────────────────────
    match /gst_bills/{billId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is number
                            && isValidNumber(request.resource.data.basicAmount)
                            && isValidNumber(request.resource.data.totalAmount)
                            && isNonEmptyString(request.resource.data.partyName)
                            && isNonEmptyString(request.resource.data.project);
      allow delete: if true;
    }

    // ── 5. Users & Credentials (યુઝર એકાઉન્ટ્સ) ──────────────────────────────
    match /users/{userId} {
      allow read: if true;
      // Prevent deleting the primary Master Owner/Admin account (id == 1)
      allow delete: if userId != "1";
      allow create, update: if request.resource.data.id is number
                            && isNonEmptyString(request.resource.data.username)
                            && isNonEmptyString(request.resource.data.password);
    }

    // ── Deny all other arbitrary collections by default ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
